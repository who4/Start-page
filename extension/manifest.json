{
  "manifest_version": 3,
  "name": "Start",
  "version": "1.1.0",
  "description": "A minimalist, customizable new tab page with shortcuts, live telemetry, and workspace modules.",
  "permissions": [
    "storage",
    "tabs",
    "bookmarks",
    "history",
    "contextMenus",
    "alarms",
    "notifications",
    "favicon"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "*://alanchand.com/*",
    "*://*.tgju.org/*",
    "*://apiv2.nobitex.ir/*",
    "*://api.wallex.ir/*",
    "*://api.binance.com/*",
    "*://duckduckgo.com/*",
    "*://api.rss2json.com/*",
    "*://feeds.bbci.co.uk/*",
    "*://www.aljazeera.com/*",
    "*://hnrss.org/*",
    "*://www.theverge.com/*",
    "*://feeds.arstechnica.com/*",
    "*://*.iranmonitor.org/*",
    "*://api.open-meteo.com/*",
    "*://air-quality-api.open-meteo.com/*",
    "*://geocoding-api.open-meteo.com/*",
    "*://photon.komoot.io/*",
    "*://nominatim.openstreetmap.org/*",
    "*://icons.duckduckgo.com/*",
    "*://*.gstatic.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  },
  "action": {
    "default_icon": "src/icon.png"
  },
  "icons": {
    "128": "src/icon.png"
  }
}
