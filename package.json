{
  "name": "chrome-extension",
  "version": "1.1.0",
  "description": "System Terminal — minimalist three-pane Chrome new-tab extension.",
  "scripts": {
    "build": "vite build",
    "build:ext": "vite build --mode extension",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "watch": "vite build --watch --mode extension",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/who4/Home-Extension-Chrome.git"
  },
  "keywords": [],
