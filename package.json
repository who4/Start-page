  "bugs": {
    "url": "https://github.com/who4/Home-Extension-Chrome/issues"
  },
  "homepage": "https://github.com/who4/Home-Extension-Chrome#readme",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.7",
    "happy-dom": "^20.11.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
